{
	"info": {
		"_postman_id": "lost-and-found-portal-collection",
		"name": "Lost & Found Portal API Collection",
		"description": "Complete Postman collection for testing the Lost & Found Portal REST APIs, including Authentication, Items management, Claims lifecycle, User profile, and Admin operations.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Test User\",\n  \"phoneNumber\": \"+1 555-0199\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						}
					}
				},
				{
					"name": "Login (User)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.environment.set(\"token\", jsonData.data.token);",
									"    pm.collectionVariables.set(\"token\", jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"usernameOrEmail\": \"testuser\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.environment.set(\"token\", jsonData.data.token);",
									"    pm.collectionVariables.set(\"token\", jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Items",
			"item": [
				{
					"name": "Get All Items (Filtered / Search)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/items?type=&category=&status=&keyword=",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"items"
							],
							"query": [
								{ "key": "type", "value": "" },
								{ "key": "category", "value": "" },
								{ "key": "status", "value": "" },
								{ "key": "keyword", "value": "" }
							]
						}
					}
				},
				{
					"name": "Get Item by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/items/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"items",
								"1"
							]
						}
					}
				},
				{
					"name": "Report Item (Multipart)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "title", "value": "Wireless Earbuds", "type": "text" },
								{ "key": "description", "value": "Black Sony WF-1000XM4 inside matte charging case.", "type": "text" },
								{ "key": "category", "value": "Electronics", "type": "text" },
								{ "key": "type", "value": "FOUND", "type": "text" },
								{ "key": "location", "value": "Study Hall B, Table 4", "type": "text" },
								{ "key": "itemDate", "value": "2026-10-26", "type": "text" }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/items",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"items"
							]
						}
					}
				},
				{
					"name": "Get My Reported Items",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/items/my-items",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"items",
								"my-items"
							]
						}
					}
				}
			]
		},
		{
			"name": "3. Claims",
			"item": [
				{
					"name": "Submit Ownership Claim",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"itemId\": 1,\n  \"proofDescription\": \"It has a small scratch on the upper left lid and serial starts with SN-9821.\",\n  \"contactInfo\": \"555-0188 or claimer@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/claims",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"claims"
							]
						}
					}
				},
				{
					"name": "Get My Submitted Claims",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/claims/my-claims",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"claims",
								"my-claims"
							]
						}
					}
				},
				{
					"name": "Update Claim Status (Approve/Reject)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"APPROVED\",\n  \"remarks\": \"Details verified. Handover confirmed.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/claims/1/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"claims",
								"1",
								"status"
							]
						}
					}
				}
			]
		},
		{
			"name": "4. Admin Console",
			"item": [
				{
					"name": "Get Platform Stats",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/admin/stats",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"stats"
							]
						}
					}
				},
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/admin/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"users"
							]
						}
					}
				}
			]
		}
	]
}
